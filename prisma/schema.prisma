generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@index([createdAt])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

model BlogPost {
  id                String                  @id @default(cuid())
  slug              String                  @unique @db.VarChar(180)
  publishedSlug     String?                 @unique @db.VarChar(180)
  category          String                  @db.VarChar(100)
  author            String                  @db.VarChar(120)
  readTimeMinutes   Int                     @default(6)
  coverTone         String                  @default("mint") @db.VarChar(20)
  coverNote         String?                 @db.VarChar(240)
  coverNumber       String?                 @db.VarChar(20)
  coverMediaId      String?                 @db.VarChar(191)
  sidebarVideoUrl   String?                 @db.VarChar(500)
  sidebarVideoId    String?                 @db.VarChar(64)
  sidebarVideoTitle String?                 @db.VarChar(240)
  status            String                  @default("DRAFT") @db.VarChar(16)
  isFeatured        Boolean                 @default(false)
  noIndex           Boolean                 @default(false)
  canonicalUrl      String?                 @db.VarChar(500)
  sortOrder         Int                     @default(0)
  revision          Int                     @default(1)
  publishedRevision Int?
  publishedSnapshot Json?
  publishedAt      DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  translations      BlogPostTranslation[]
  media             BlogPostMedia[]
  services          BlogPostService[]
  revisions         BlogPostRevision[]
  redirects         BlogPostRedirect[]     @relation("BlogPostRedirectPost")

  @@index([status, publishedAt])
  @@index([status, sortOrder])
  @@index([updatedAt])
}

model BlogPostTranslation {
  id              String   @id @default(cuid())
  postId          String
  locale          String   @db.VarChar(5)
  title           String   @db.VarChar(240)
  subtitle        String   @db.VarChar(500)
  intro           String   @db.Text
  atAGlance       String?  @db.Text
  bodyHtml        String   @db.LongText
  bodyJson        Json?
  keywords        Json
  seoTitle        String?  @db.VarChar(240)
  seoDescription  String?  @db.VarChar(320)
  coverAlt       String?  @db.VarChar(240)
  coverCaption   String?  @db.VarChar(300)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  post            BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([locale, updatedAt])
}

model BlogPostMedia {
  id          String   @id @default(cuid())
  postId      String
  mediaAssetId String? @unique @db.VarChar(191)
  kind        String   @default("IMAGE") @db.VarChar(16)
  objectKey   String   @unique @db.VarChar(500)
  contentType String   @db.VarChar(80)
  byteSize    Int
  width       Int?
  height      Int?
  altText     String?  @db.VarChar(240)
  caption     String?  @db.VarChar(300)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([postId, kind])
}

model MediaFolder {
  id        String        @id @default(cuid())
  parentId  String?
  name      String        @db.VarChar(120)
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("MediaFolderTree")
  assets    MediaAsset[]

  @@unique([parentId, name])
  @@index([parentId])
}

model MediaAsset {
  id           String         @id @default(cuid())
  folderId     String
  objectKey    String         @unique @db.VarChar(500)
  originalName String         @db.VarChar(255)
  displayName  String         @db.VarChar(255)
  contentType  String         @db.VarChar(80)
  byteSize     Int
  width        Int?
  height       Int?
  checksum     String         @db.VarChar(64)
  altText      String?        @db.VarChar(240)
  caption      String?        @db.VarChar(300)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  folder       MediaFolder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  blogMedia    BlogPostMedia?

  @@index([folderId, createdAt])
  @@index([checksum])
}

model BlogPostService {
  id         String   @id @default(cuid())
  postId     String
  serviceKey String   @db.VarChar(180)
  label      String   @db.VarChar(180)
  href       String   @db.VarChar(1000)
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, serviceKey])
  @@index([postId, sortOrder])
}

model BlogPostRevision {
  id        String   @id @default(cuid())
  postId    String
  version   Int
  kind      String   @default("DRAFT") @db.VarChar(16)
  snapshot  Json
  createdBy String?  @db.VarChar(120)
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, version])
  @@index([postId, createdAt])
}

model BlogPostRedirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique @db.VarChar(180)
  toSlug    String   @db.VarChar(180)
  postId    String
  createdAt DateTime @default(now())
  post      BlogPost @relation("BlogPostRedirectPost", fields: [postId], references: [id], onDelete: Cascade)

  @@index([toSlug])
}

model MenuSection {
  id             String      @id @default(cuid())
  key            String      @unique
  label          String
  href           String
  menuEyebrow    String?
  menuTitle      String?
  menuDescription String?
  spotlightBadge String?
  spotlightTitle String?
  spotlightDescription String?
  spotlightCtaLabel String?
  spotlightCtaHref String?
  tone           String      @default("green")
  sortOrder      Int         @default(0)
  isVisible      Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  groups         MenuGroup[]

  @@index([sortOrder])
}

model MenuGroup {
  id          String      @id @default(cuid())
  sectionId   String
  key         String
  label       String
  railLabel   String
  description String
  sortOrder   Int         @default(0)
  isVisible   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  section     MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  items       MenuItem[]

  @@unique([sectionId, key])
  @@index([sectionId, sortOrder])
}

model MenuItem {
  id          String      @id @default(cuid())
  groupId     String
  label       String
  description String
  href        String
  marker      String
  icon        String      @default("briefcase")
  sortOrder   Int         @default(0)
  isVisible   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  group       MenuGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  links       MenuLink[]
  serviceProfile ServiceProfile?

  @@unique([groupId, label])
  @@index([groupId, sortOrder])
}

model MenuLink {
  id        String   @id @default(cuid())
  itemId    String
  label     String
  href      String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  item      MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

model ServiceProfile {
  id                String                  @id @default(cuid())
  serviceKey        String                  @unique @db.VarChar(180)
  slug              String                  @unique @db.VarChar(180)
  menuItemId        String?                 @unique
  titleEn           String                  @db.VarChar(180)
  titleBn           String                  @db.VarChar(180)
  descriptionEn     String                  @db.VarChar(500)
  descriptionBn     String                  @db.VarChar(500)
  detail            Json?
  publishedDetail   Json?
  status            String                  @default("LINK_ONLY") @db.VarChar(16)
  revision          Int                     @default(1)
  publishedRevision Int?
  publishedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  menuItem          MenuItem?               @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  revisions         ServiceProfileRevision[]

  @@index([status, updatedAt])
  @@index([status, publishedAt])
}

model ServiceProfileRevision {
  id          String        @id @default(cuid())
  profileId   String
  version     Int
  kind        String        @default("DRAFT") @db.VarChar(16)
  snapshot    Json
  createdBy   String?       @db.VarChar(120)
  createdAt   DateTime      @default(now())
  profile     ServiceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, version])
  @@index([profileId, createdAt])
}

model ContactSettings {
  id               String   @id @default("default")
  revision         Int      @default(1)
  whatsappNumber   String   @db.VarChar(40)
  whatsappDisplay  String   @db.VarChar(80)
  whatsappMessage  String   @db.VarChar(500)
  email            String   @db.VarChar(200)
  phone            String   @db.VarChar(40)
  address          String   @db.VarChar(300)
  businessHours    String   @db.VarChar(240)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AboutTeamMember {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  title       String   @db.VarChar(160)
  description String   @db.Text
  imageKey    String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model AboutReel {
  id           String   @id @default(cuid())
  youtubeUrl   String   @db.VarChar(500)
  videoId      String   @db.VarChar(32)
  title        String?  @db.VarChar(160)
  youtubeTitle String?  @db.VarChar(200)
  sortOrder    Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
}

model LandingPage {
  id        String   @id @default("home")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessToolSettings {
  id        String   @id @default("default")
  version   Int      @default(1)
  settings  Json
  updatedAt DateTime @updatedAt
}

model DocumentTemplate {
  id                 String    @id @default(cuid())
  slug               String    @unique @db.VarChar(180)
  title              String    @db.VarChar(180)
  description        String    @db.Text
  settings           Json
  fields             Json
  blocks             Json
  pages              Json?
  publishedSettings  Json?
  publishedFields    Json?
  publishedBlocks    Json?
  publishedPages     Json?
  status             String    @default("DRAFT") @db.VarChar(16)
  revision           Int       @default(1)
  publishedRevision  Int?
  publishedAt        DateTime?
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([status, sortOrder])
  @@index([sortOrder])
  @@index([updatedAt])
}

model ToolServiceRequest {
  id           String   @id @default(cuid())
  submissionId String   @unique @db.VarChar(36)
  toolSlug     String   @db.VarChar(80)
  name         String   @db.VarChar(120)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(200)
  preferredDate String? @db.VarChar(10)
  preferredTime String? @db.VarChar(5)
  requestType  String   @default("CALLBACK") @db.VarChar(24)
  message      String   @db.Text
  context      Json
  status       String   @default("NEW") @db.VarChar(24)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([requestType, createdAt])
  @@index([toolSlug, createdAt])
}
