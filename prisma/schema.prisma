generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@index([createdAt])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

model MenuSection {
  id             String      @id @default(cuid())
  key            String      @unique
  label          String
  href           String
  menuEyebrow    String?
  menuTitle      String?
  menuDescription String?
  spotlightBadge String?
  spotlightTitle String?
  spotlightDescription String?
  spotlightCtaLabel String?
  spotlightCtaHref String?
  tone           String      @default("green")
  sortOrder      Int         @default(0)
  isVisible      Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  groups         MenuGroup[]

  @@index([sortOrder])
}

model MenuGroup {
  id          String      @id @default(cuid())
  sectionId   String
  key         String
  label       String
  railLabel   String
  description String
  sortOrder   Int         @default(0)
  isVisible   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  section     MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  items       MenuItem[]

  @@unique([sectionId, key])
  @@index([sectionId, sortOrder])
}

model MenuItem {
  id          String      @id @default(cuid())
  groupId     String
  label       String
  description String
  href        String
  marker      String
  icon        String      @default("briefcase")
  sortOrder   Int         @default(0)
  isVisible   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  group       MenuGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  links       MenuLink[]

  @@unique([groupId, label])
  @@index([groupId, sortOrder])
}

model MenuLink {
  id        String   @id @default(cuid())
  itemId    String
  label     String
  href      String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  item      MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

model AboutTeamMember {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  title       String   @db.VarChar(160)
  description String   @db.Text
  imageKey    String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model AboutReel {
  id           String   @id @default(cuid())
  youtubeUrl   String   @db.VarChar(500)
  videoId      String   @db.VarChar(32)
  title        String?  @db.VarChar(160)
  youtubeTitle String?  @db.VarChar(200)
  sortOrder    Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
}

model LandingPage {
  id        String   @id @default("home")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessToolSettings {
  id        String   @id @default("default")
  version   Int      @default(1)
  settings  Json
  updatedAt DateTime @updatedAt
}

model ToolServiceRequest {
  id           String   @id @default(cuid())
  submissionId String   @unique @db.VarChar(36)
  toolSlug     String   @db.VarChar(80)
  name         String   @db.VarChar(120)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(200)
  preferredDate String? @db.VarChar(10)
  preferredTime String? @db.VarChar(5)
  requestType  String   @default("CALLBACK") @db.VarChar(24)
  message      String   @db.Text
  context      Json
  status       String   @default("NEW") @db.VarChar(24)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([requestType, createdAt])
  @@index([toolSlug, createdAt])
}
