NODE_ENV=development

# Local MySQL connection (matches docker-compose.yml).
DATABASE_URL="mysql://limex:limex@127.0.0.1:3306/limex"

# Internal ports. Railway's public PORT is reserved for the gateway.
FRONTEND_PORT=3000
BACKEND_PORT=4000
# Local gateway override; Railway's injected PORT takes precedence there.
GATEWAY_PORT=8080

# Comma-separated origins are supported by the API.
CORS_ORIGIN=http://localhost:3000
