NODE_ENV=development

# Local MySQL connection (matches docker-compose.yml).
DATABASE_URL="mysql://limex:limex@127.0.0.1:3306/limex"

# Internal ports. Railway's public PORT is reserved for the gateway.
FRONTEND_PORT=3000
BACKEND_PORT=4000
# Local gateway override; Railway's injected PORT takes precedence there.
GATEWAY_PORT=8080

# Comma-separated origins are supported by the API.
CORS_ORIGIN=http://localhost:3000

# Admin access. Use a long random session secret outside local development.
ADMIN_USERNAME=test
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-value

# Public URL and internal server URL used by dynamic blog metadata and SSR.
PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# S3-compatible private object storage (Railway Bucket/Tigris, R2, or MinIO).
# Media delivery uses short-lived signed URLs behind stable /api/media links.
BUCKET=
ENDPOINT=
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
