NODE_ENV=development

# Railway's PostgreSQL plugin supplies this value in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/limex?schema=public

# Internal ports. Railway's public PORT is reserved for the gateway.
FRONTEND_PORT=3000
BACKEND_PORT=4000
# Local gateway override; Railway's injected PORT takes precedence there.
GATEWAY_PORT=8080

# Comma-separated origins are supported by the API.
CORS_ORIGIN=http://localhost:3000
