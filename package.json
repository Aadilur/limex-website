{
  "name": "limex-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend --prefix-colors blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:backend": "tsx watch server/index.ts",
    "build": "npm run prisma:generate && next build && npm run build:backend",
    "build:backend": "tsc -p tsconfig.server.json",
    "start": "prisma migrate deploy && npm run db:seed && node scripts/start-production.mjs",
    "start:frontend": "next start --hostname 127.0.0.1 --port 3000",
    "start:backend": "node dist/server/index.js",
    "start:gateway": "node scripts/gateway.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-blogs": "tsx scripts/import-menu-blogs.ts",
    "db:sync-menu-services": "tsx scripts/sync-menu-services.ts",
    "db:upgrade-tools": "tsx scripts/upgrade-business-tools-content.ts",
    "test:tools": "node --import tsx --test scripts/business-tools.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.15.0",
    "@tiptap/extension-color": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "docx": "^9.7.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "gsap": "^3.15.0",
    "http-proxy": "^1.18.1",
    "lenis": "^1.3.26",
    "next": "^15.5.4",
    "prisma": "^6.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
